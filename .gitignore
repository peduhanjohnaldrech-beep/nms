# Environment & secrets
.env

# SQLite database (contains live data)
database/nms.sqlite
database/*.sqlite

# Composer vendor directory
vendor/

# Storage uploads (but allow templates)
storage/*
!storage/templates/
storage/templates/*
!storage/templates/*.xlsx
!storage/templates/*.xltx

# Diagnostic/debug scripts (one-time use)
diag_*.php

# Zip files
*.zip

# PHP built-in server log
*.log

# OS files
.DS_Store
Thumbs.db
